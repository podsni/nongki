# Password untuk masuk ke /admin (wajib). Buat yang panjang & acak, mis: openssl rand -base64 24
ADMIN_PASSWORD=

# Kunci HMAC untuk menandatangani cookie sesi admin (disarankan). Mis: openssl rand -hex 32
# Jika kosong, ADMIN_PASSWORD dipakai sebagai kunci.
SESSION_SECRET=

# Token Vercel Blob (otomatis dibuat saat Blob store di-connect ke project Vercel).
# Jika kosong, data disimpan ke file lokal .data/db.json (cocok untuk development).
BLOB_READ_WRITE_TOKEN=

# (Opsional) Domain default untuk link share bila host tidak dikenal.
NEXT_PUBLIC_SITE_URL=https://nongki-malang.vercel.app
# (Opsional) Domain tambahan yang boleh dipakai di link share, pisahkan koma.
ALLOWED_HOSTS=
